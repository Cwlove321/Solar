! Shared initial atmosphere and fixed bottom-boundary thermodynamics.
&atmosphere_list
  atmosphere_model = 'analytic_tr'
  atmosphere_normalization = 'number_density'
  atmosphere_reference_height_Mm = 10.d0
  atmosphere_reference_nH_cgs = 6.2d8
  atmosphere_reference_pressure_cgs = 138.365d0
  atmosphere_chromosphere_K = 8000.d0
  atmosphere_tanh_top_K = 1.5d6
  atmosphere_transition_height_Mm = 2.d0
  atmosphere_transition_width_Mm = 0.25d0
  atmosphere_transition_K = 1.6d5
  atmosphere_conductive_flux_cgs = 2.d5
  atmosphere_floor_height_Mm = -0.2d0
  atmosphere_isothermal_K = 1.d6
/

&filelist
  base_filename = './data/pfss_global_ct_'
  saveprim      = .true.
  autoconvert   = .false.
  nwauxio       = 12
  convert_type  = 'vtuBmpi'
/

&savelist
  ditsave_log = 1
  itsave(1,1) = 0
  itsave(1,2) = 0
  itsave(1,5) = 0
/

&stoplist
  dtmin         = 1.d-8
  time_max      = 0.d0
  wall_time_max = 48.d0
/

&methodlist
  time_stepper        = 'threestep'
  flux_scheme         = 20*'hll'
  limiter             = 20*'cada3'
  small_density       = 1.d-3
  small_pressure      = 1.d-3
  fix_small_values    = .true.
  small_values_method = 'replace'
/

&boundlist
  typeboundary_min1 = 8*'special'
  typeboundary_max1 = 8*'special'
  typeboundary_min2 = 8*'special'
  typeboundary_max2 = 8*'special'
  typeboundary_min3 = 8*'special'
  typeboundary_max3 = 8*'special'
/

&meshlist
  refine_criterion      = 3
  refine_max_level      = 4
  refine_threshold      = 0.2d0, 0.4d0, 0.6d0, 0.8d0, 16*0.2d0
  derefine_ratio        = 20*1.d0
  w_refine_weight(1)    = 1.d0
  block_nx1             = 12
  block_nx2             = 12
  block_nx3             = 12
  domain_nx1            = 72
  domain_nx2            = 36
  domain_nx3            = 72
  xprobmin1             = 1d0
  xprobmax1             = 1.5d0
  xprobmin2             = 0.16d0
  xprobmax2             = 0.24d0
  xprobmin3             = 0.4616666666666667d0
  xprobmax3             = 0.6216666666666667d0
  stretch_dim(1)        = 'uni'
  qstretch_baselevel(1) = 1.041541581503301d0
  ditregrid             = 3
  itfixgrid             = 0
  max_blocks            = 70000
  iprob                 = 1
/

&paramlist
  typecourant = 'maxsum'
  courantpar  = 0.8d0
/

&mhd_list
  mhd_energy             = .true.
  mhd_gravity            = .true.
  typedivbfix            = 'ct'
  mhd_thermal_conduction = .false.
  mhd_radiative_cooling  = .false.
  mhd_semirelativistic   = .true.
  mhd_reduced_c          = 6.d8
  mhd_internal_e         = .true.
  mhd_trac               = .false.
  mhd_adiab              = 1.4d0
  mhd_eta                = 2.4693930682273452d-6
/

&Mag_list
  do_rbsl    = .true.
  Bflux      = 1.3d+20
  I_Helix    = .false.
  Rmfr       = 15d0
  npoints    = 6000
  flip_axis  = .false.
  weak_field = .false.
  wf_scale   = 0.d0
/

&GlobalPFSS_list
  global_boundary_file            = 'potential_boundary/pfss_boundary.dat'
  global_subtracted_boundary_file = 'potential_boundary/pfss_boundary_subtracted.dat'
  global_patch_x0                 = 1662
  global_patch_y0                 = 936
  global_expected_nphi            = 3600
  global_expected_ntheta          = 1800
  global_pfss_lmax                = 360
  global_pfss_r0                  = 1d0
  global_pfss_rs                  = 2.5d0
/

