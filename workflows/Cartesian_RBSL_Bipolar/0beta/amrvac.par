!setup.pl -d=3
 &filelist
        restart_from_file='../mf/data/mf0004.dat'
        base_filename='data/eru'
        saveprim=.true.
        convert_type='vtuBmpi'
        autoconvert=.false.
        nwauxio=0
 /

 &savelist
        itsave(1,1)=0
        itsave(1,2)=0
        dtsave_log=0.05d0
        dtsave_dat=0.25d0
 /

 &stoplist
        time_max=25.0d0
        reset_time=.true.
 /
        reset_time=.true.
        reset_time=.true.
        reset_time=.true.
        reset_time=.true.
        reset_time=.true.
        reset_time=.true.
        reset_time=.true.

 &methodlist
        time_stepper=  'threestep'
        flux_scheme=    20*'hll'
        limiter= 20*'weno5'
        small_density = 1d-3 
        small_values_method = 'replace'
        fix_small_values=.true.
 /
        small_pressure = 1.088423289516846d-3 
        small_pressure = 4.638715018354037d-4 

 &boundlist
        typeboundary_min1=7*'special'
        typeboundary_max1=7*'special'
        typeboundary_min2=7*'special'
        typeboundary_max2=7*'special'
        typeboundary_min3=7*'special'
        typeboundary_max3=7*'special'
 /

 &meshlist
        refine_criterion=3
        refine_max_level=4
        w_refine_weight(1)=0.4d0
        w_refine_weight(5)=0.2d0
        w_refine_weight(6)=0.2d0
        w_refine_weight(7)=0.2d0
        block_nx1=10
        block_nx2=10
        block_nx3=10
        domain_nx1=60
        domain_nx2=60
        domain_nx3=60
        xprobmin1=-10.0d0
        xprobmax1=10.0d0
        xprobmin2=-10.0d0
        xprobmax2=10.0d0
        xprobmin3=0.3d0
        xprobmax3=20.3d0
        max_blocks=40000
	ditregrid=3
 /
        w_refine_weight(1)=0.4d0
        w_refine_weight(6)=0.2d0
        w_refine_weight(7)=0.2d0
        w_refine_weight(8)=0.2d0

 &paramlist
        typecourant='maxsum'
        courantpar=0.8d0
 /

 &mhd_list
        mhd_energy=.False.
        mhd_gravity=.false.
        mhd_viscosity=.false.
	mhd_internal_e=.false.
        typedivbfix='ct'
        mhd_adiab=0.0d0
        mhd_thermal_conduction=.flase.
        mhd_radiative_cooling=.false.
 /
        mhd_eta = 4.0d-4
        mhd_energy=.false.
        mhd_gravity=.true.
        mhd_adiab=1.0d0
        mhd_gamma=1.0d0
	mhd_internal_e=.false.
        typedivbfix='ct'
        mhd_thermal_conduction=.false.
        mhd_radiative_cooling=.false.
        mhd_eta = 5.0d-4
        mhd_eta = 4.0d-4
        mhd_trac=.true.
        mhd_thermal_conduction=.true.
        mhd_radiative_cooling=.true.
        mhd_solve_eaux=.true.
        typedivbfix='glm'
        typedivbfix='linde'
        B0field=.true.
        B0field_forcefree=.true.

 &vc_list
        vc_mu = 1.d-4
/

 &tc_list
        tc_perpendicular=.false.
        tc_saturate=.true.
 /
