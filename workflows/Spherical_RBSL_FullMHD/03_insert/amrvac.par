! Shared initial atmosphere and fixed bottom-boundary thermodynamics.
&atmosphere_list
  atmosphere_model = 'analytic_tr'
  atmosphere_normalization = 'number_density'
  atmosphere_reference_height_Mm = 10.d0
  atmosphere_reference_nH_cgs = 6.2d8
  atmosphere_reference_pressure_cgs = 138.365d0
  atmosphere_chromosphere_K = 8000.d0
  atmosphere_tanh_top_K = 1.5d6
  atmosphere_transition_height_Mm = 2.d0
  atmosphere_transition_width_Mm = 0.25d0
  atmosphere_transition_K = 1.6d5
  atmosphere_conductive_flux_cgs = 2.d5
  atmosphere_floor_height_Mm = -0.2d0
  atmosphere_isothermal_K = 1.d6
/

&filelist
  base_filename = './data/rbsl_insert_load_'
  restart_from_file = './restart.dat'
  firstprocess  = .true.
  saveprim      = .true.
  autoconvert   = .false.
  nwauxio       = 12
  convert_type  = 'vtuBmpi'
/

&savelist
  ditsave_log = 1
  dtsave_dat  = 1.6743471309306326d-3
  itsave(1,1) = 0
  itsave(1,2) = 0
  itsave(1,5) = 0
/

&stoplist
  dtmin         = 1.d-10
  time_max      = 1.8417818440236957d-2
  reset_time    = .true.
  wall_time_max = 95.d0
  it_max        = 600000
/

&methodlist
  time_stepper        = 'threestep'
  flux_scheme         = 20*'hll'
  limiter             = 20*'vanleer'
  small_density       = 1.d-3
  small_pressure      = 1.d-3
  fix_small_values    = .true.
  small_values_method = 'replace'
  check_small_values  = .false.
/

&boundlist
  typeboundary_min1 = 8*'special'
  typeboundary_max1 = 8*'special'
  typeboundary_min2 = 8*'special'
  typeboundary_max2 = 8*'special'
  typeboundary_min3 = 8*'special'
  typeboundary_max3 = 8*'special'
/

&meshlist
  refine_criterion   = 3
  refine_max_level   = 4
  refine_threshold   = 0.2d0, 0.4d0, 0.6d0, 0.8d0, 16*0.2d0
  derefine_ratio     = 20*1.d0
  w_refine_weight(1) = 1.d0
  block_nx1          = 12
  block_nx2          = 12
  block_nx3          = 12
  domain_nx1         = 72
  domain_nx2         = 36
  domain_nx3         = 72
  xprobmin1          = 1.d0
  xprobmax1          = 1.5d0
  xprobmin2          = 0.16d0
  xprobmax2          = 0.24d0
  xprobmin3          = 0.46166666666666667d0
  xprobmax3          = 0.62166666666666667d0
  stretch_dim(1)     = 'uni'
  qstretch_baselevel(1) = 1.041541581503301d0
  ditregrid          = 3
  itfixgrid           = 0
  max_blocks         = 40000
  iprob              = 2
/

&paramlist
  typecourant = 'maxsum'
  courantpar  = 0.8d0
/

&mhd_list
  mhd_energy             = .true.
  mhd_gravity            = .true.
  typedivbfix            = 'ct'
  mhd_thermal_conduction = .true.
  mhd_radiative_cooling  = .false.
  mhd_semirelativistic   = .true.
  mhd_reduced_c          = 6.d8
  mhd_internal_e         = .true.
  mhd_trac               = .true.
  mhd_trac_type          = 2
  mhd_gamma              = 1.6666666666666667d0
  mhd_adiab              = 1.4d0
  mhd_eta                = 2.4693930682273452d-6
/

&Mag_list
  do_rbsl                    = .true.
  Bflux                      = 1.29d20
  I_Helix                    = .false.
  Rmfr                       = 15.d0
  npoints                    = 6000
  flip_axis                  = .false.
  weak_field                 = .false.
  wf_scale                   = 0.d0
  load_filament_density      = .false.
  filament_density_factor    = 20.d0
  filament_core_fraction     = 0.6d0
  filament_min_height_Mm     = 5.d0
  liakh_mass_loading         = .true.
  liakh_density_contrast     = 30.d0
  liakh_t_start_s            = 0.d0
  liakh_t_load_s             = 100.d0
  liakh_sigma_horizontal_Mm  = 3.6d0
  liakh_sigma_radial_Mm      = 4.8d0
  liakh_min_height_Mm        = 5.d0
  background_heating_cgs     = 1.d-4
/

&tc_list
  tc_perpendicular = .false.
  tc_saturate      = .true.
/

&sts_list
  sts_dtpar = 0.2d0
/
