! Conversion-only parameter file for selected TMF snapshots.
 &filelist
        base_filename='data/driven'
        saveprim=.true.
        autoconvert=.true.
        convert_type='vtuBmpi'
        nwauxio=0
        level_io=2
        w_write(1)=.false.
        w_write(2)=.false.
        w_write(3)=.false.
 /

 &savelist
        itsave(1,1)=0
        itsave(1,2)=0
 /

 &methodlist
        time_stepper='threestep'
        flux_scheme=20*'hll'
        limiter=20*'cada3'
 /

 &boundlist
        typeboundary_min1=6*'special'
        typeboundary_max1=6*'special'
        typeboundary_min2=6*'special'
        typeboundary_max2=6*'special'
        typeboundary_min3=6*'special'
        typeboundary_max3=6*'special'
 /

 &meshlist
        refine_criterion=3
        refine_max_level=1
        refine_threshold=20*0.2d0
        derefine_ratio=20*0.1d0
        block_nx1=10
        block_nx2=10
        block_nx3=10
        domain_nx1=300
        domain_nx2=150
        domain_nx3=150
        xprobmin1=-10.992375d0
        xprobmax1=10.992375d0
        xprobmin2=-5.4961875d0
        xprobmax2=5.4961875d0
        xprobmin3=0.1d0
        xprobmax3=10.992375d0
        ditregrid=20
 /

 &mf_list
        typedivbfix='linde'
        mf_eta=-1.0d-3
        boundary_divbfix_skip(5)=1
 /
