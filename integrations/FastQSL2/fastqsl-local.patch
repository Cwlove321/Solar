+def _find_fastqsl_executable():
+    """Return the configured or locally compiled FastQSL2 executable."""
+    configured = os.environ.get('FASTQSL2_EXECUTABLE')
+    executable = Path(configured).expanduser() if configured else Path(__file__).resolve().parent / 'bin' / 'fastqsl.x'
+    executable = executable.resolve()
+    if not executable.is_file():
+        raise FileNotFoundError(
+            f'FastQSL2 executable not found: {executable}. '
+            'Run scripts/build_fastqsl.sh or set FASTQSL2_EXECUTABLE.'
+        )
+    if not os.access(executable, os.X_OK):
+        raise PermissionError(f'FastQSL2 executable is not executable: {executable}')
+    return executable
 
